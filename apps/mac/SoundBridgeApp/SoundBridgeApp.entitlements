<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Hardened runtime with no exceptions. The app does not record audio, so it
	does not request the audio-input entitlement. App Sandbox is off because the
	app launches the host and installs the HAL driver; sandbox-only keys (network,
	user-selected files) would have no effect and are intentionally omitted.
	Keep in sync with the allowlist in tools/verify_signatures.sh.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<false/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<false/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<false/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<false/>
</dict>
</plist>
